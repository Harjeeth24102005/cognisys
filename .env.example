# Cognisys EmailJS Configuration
# Get these 3 values from your free https://www.emailjs.com/ account:
# 1. Email Services -> Service ID (connected to contact.cognisys@gmail.com)
VITE_EMAILJS_SERVICE_ID=

# 2. Email Templates -> Admin Template ID (delivered to contact.cognisys@gmail.com)
VITE_EMAILJS_ADMIN_TEMPLATE_ID=

# 3. Email Templates -> Client Autoresponder Template ID (delivered to client's email) - Optional
VITE_EMAILJS_CLIENT_TEMPLATE_ID=

# 4. Account -> Public Key
VITE_EMAILJS_PUBLIC_KEY=
